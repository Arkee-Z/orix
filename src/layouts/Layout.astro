---
import "../styles/global.css";
import Tabs from "../components/Tabs.astro";
import { site } from "../data/site";

interface Props {
	title?: string;
	section: string;
	folio: string;
	description?: string;
	mainClass?: string;
}

const {
	title,
	section,
	folio,
	description = site.description,
	mainClass,
} = Astro.props;

const pageTitle = title
	? `${title} — ${site.imprint}`
	: `${site.imprint} — A Journal of Code & Consequence`;
---


<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0c0a09" />
		<link
			rel="icon"
			type="image/svg+xml"
			href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23111110'/%3E%3Cg fill='none' stroke='%23F4EFE6' stroke-width='4' stroke-linecap='round'%3E%3Cpath d='M7.5 27.5C4.5 20.5 7 10.5 16 4'/%3E%3Cpath d='M24.5 27.5C27.5 20.5 25 10.5 16 4'/%3E%3C/g%3E%3C/svg%3E"
		/>
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary" />
		<title>{pageTitle}</title>
		<link
			rel="preload"
			href="/fonts/plex-300.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/plex-400i.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/space-700.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to the page</a>

		<div class="stage">
			<div class="book-wrap">
				<Tabs />

				<div class="book">
					<div class="spine" aria-hidden="true">
						<span class="band band-top"></span>
						<span class="spine-year">{site.year}</span>
						<span class="spine-title">Orix · A Journal of Code</span>
						<span class="spine-mark">❦</span>
						<span class="band band-bottom"></span>
					</div>

					<div class="page">
						<div class="page-head">
							<span class="rh-section">{section}</span>
							<span class="rh-right">{site.imprint} · {site.volume}</span>
						</div>

						<main class:list={["leaf", mainClass]} id="main" tabindex="0">
							<div class="leaf-inner">
								<slot />
							</div>
						</main>

						<div class="folio">
							<span class="folio-left">{site.since} · {site.location}</span>
							<span class="folio-right">Leaf {folio}</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</body>
</html>
