---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/inter";
import "../styles/global.css";
import Tabs from "../components/Tabs.astro";
import { site } from "../data/site";
import {
	getUi,
	localeHref,
	otherLang,
	switchLocalePath,
	type Lang,
} from "../i18n/ui";

interface Props {
	title?: string;
	section: string;
	folio: string;
	lang: Lang;
	description?: string;
	mainClass?: string;
	altHref?: string;
}

const {
	title,
	section,
	folio,
	lang,
	description = getUi(lang).description,
	mainClass,
	altHref,
} = Astro.props;

const t = getUi(lang);
const other = otherLang(lang);
const pageTitle = title
	? `${title} — ${t.imprint}`
	: `${t.imprint} — ${
			lang === "zh" ? "文学、音乐与美术" : "A Journal of Code & Consequence"
		}`;
const otherHref = altHref ?? switchLocalePath(Astro.url.pathname, other);
const canonical = new URL(Astro.url.pathname, site.url).toString();
const otherAbsolute = new URL(otherHref, site.url).toString();
const zhHref = lang === "zh" ? canonical : otherAbsolute;
const enHref = lang === "en" ? canonical : otherAbsolute;
const feedHref = lang === "zh" ? "/zh/rss.xml" : "/en/rss.xml";
---


<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f4efe5" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={lang === "zh" ? "zh_CN" : "en_US"} />
		<meta property="og:locale:alternate" content={lang === "zh" ? "en_US" : "zh_CN"} />
		<meta name="twitter:card" content="summary" />
		<title>{pageTitle}</title>
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="zh-CN" href={zhHref} />
		<link rel="alternate" hreflang="en" href={enHref} />
		<link rel="alternate" hreflang="x-default" href={zhHref} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${t.siteName} · RSS`}
			href={feedHref}
		/>
	</head>
	<body>
		<a class="skip-link" href="#main">{t.skip}</a>

		<header class="site-header">
			<div class="header-inner">
				<a class="brand" href={lang === "zh" ? "/zh/" : "/en/"}>
					<span class="brand-word">Orix</span>
					<span class="brand-cn">{lang === "zh" ? "文艺志" : "Journal"}</span>
				</a>

				<Tabs lang={lang} />

				<div class="header-tools">
					<span class="header-issue">{t.volume} · No. {site.issue}</span>
					<a
						class="lang-switch"
						href={otherHref}
						hreflang={other === "zh" ? "zh-CN" : "en"}
						lang={other === "zh" ? "zh-CN" : "en"}
					>
						{t.switchLanguage}
					</a>
				</div>
			</div>
		</header>

		<main class="site-main" id="main" data-section={section}>
			<div class:list={["page-content", mainClass]}>
				<slot />
			</div>
		</main>

		<footer class="site-footer">
			<div class="footer-inner">
				<span>{t.imprint} · {t.volume} · {t.since}</span>
				<span>{section} · {folio}</span>
				<span class="footer-links">
					<a href={localeHref(lang, "/music")}>{t.nav.music}</a>
					<span aria-hidden="true">/</span>
					<a href={localeHref(lang, "/art")}>{t.nav.art}</a>
					<span aria-hidden="true">/</span>
					<a href={feedHref}>RSS</a>
					<span aria-hidden="true">/</span>
					<a href={`mailto:${site.email}`}>{lang === "zh" ? "来信" : "Email"}</a>
				</span>
			</div>
		</footer>
	</body>
</html>
