---
import "../styles/global.css";
import DepartmentNav from "../components/DepartmentNav.astro";
import { site } from "../data/site";

interface Props {
	title?: string;
	section: string;
	folio: string;
	description?: string;
	mainClass?: string;
}

const {
	title,
	section,
	folio,
	description = site.description,
	mainClass,
} = Astro.props;

const pageTitle = title
	? `${title} — ${site.imprint}`
	: `${site.imprint} — A Journal of Code & Consequence`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f2e8d5" />
		<link
			rel="icon"
			type="image/svg+xml"
			href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23111110'/%3E%3Cg fill='none' stroke='%23F4EFE6' stroke-width='4' stroke-linecap='round'%3E%3Cpath d='M7.5 27.5C4.5 20.5 7 10.5 16 4'/%3E%3Cpath d='M24.5 27.5C27.5 20.5 25 10.5 16 4'/%3E%3C/g%3E%3C/svg%3E"
		/>
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary" />
		<title>{pageTitle}</title>
		<link
			rel="preload"
			href="/fonts/plex-400.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/plex-400i.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/space-700.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to the page</a>

		<div class="magazine">
			<header class:list={["masthead", { "masthead--compact": mainClass !== "page--index" }]}>
				<div class="masthead-meta">
					<span>{site.volume} · No. {site.issue}</span>
					<span class="masthead-meta-mid">A journal of code &amp; consequence</span>
					<span>{site.year} · {site.location}</span>
				</div>

				<div class="masthead-main">
					<a class="masthead-logo" href="/" aria-label={`${site.imprint}, home`}>
						<span class="masthead-word">Orix</span>
						<span class="masthead-dot" aria-hidden="true"></span>
					</a>
					<p class="masthead-dek">{site.description}</p>
					<div class="masthead-issue" aria-label={`Issue ${site.issue}`}>
						<span class="masthead-issue-label">Issue</span>
						<strong class="masthead-issue-number">{site.issue}</strong>
						<span class="masthead-issue-year">{site.year}</span>
					</div>
				</div>

				<DepartmentNav />
			</header>

			<div class="running-head">
				<span class="running-section">{section}</span>
				<span class="running-imprint">{site.imprint} · {site.volume} · No. {site.issue}</span>
				<span class="running-folio">{folio}</span>
			</div>

			<main class:list={["issue", mainClass]} id="main" tabindex="0">
				<slot />
			</main>

			<footer class="site-footer">
				<div class="footer-grid">
					<div class="footer-block footer-brand">
						<p class="label">Orix Journal</p>
						<p>
							An independent journal of code, tools and consequence, written
							from a terminal in {site.location}.
						</p>
					</div>
					<div class="footer-block">
						<p class="label">Colophon</p>
						<p>
							Labels set in IBM Plex Mono and Space Mono. Display and text in
							the native editorial serif. Printed on a screen, grain and all.
						</p>
					</div>
					<div class="footer-block footer-contact">
						<p class="label">Correspondence</p>
						<a href={`mailto:${site.email}`}>{site.email}</a>
						<a href={site.github} rel="me">{site.githubLabel}</a>
					</div>
				</div>
				<div class="footer-bottom">
					<span>© {site.year} Gene Max Zhang</span>
					<span>Printed in the browser · {site.location}</span>
				</div>
			</footer>
		</div>
	</body>
</html>
