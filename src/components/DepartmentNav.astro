---
import { nav } from "../data/site";
import { pad } from "../data/site";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

function isActive(href: string): boolean {
	const target = href.replace(/\/+$/, "") || "/";
	return target === "/" ? path === "/" : path === target || path.startsWith(`${target}/`);
}
---

<nav class="departments" aria-label="Sections">
	{
		nav.map((item, index) => (
			<a
				href={item.href}
				class:list={["department", { "is-active": isActive(item.href) }]}
				style={`--dept-color: ${item.color}`}
				aria-current={isActive(item.href) ? "page" : undefined}
			>
				<span class="department-no">{pad(index + 1)}</span>
				<span class="department-name">{item.label}</span>
				<span class="department-mark" aria-hidden="true" />
			</a>
		))
	}
</nav>
