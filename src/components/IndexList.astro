---
import { dateLabel, getUi, type Lang } from "../i18n/ui";
import type { IndexItem } from "../lib/posts";

interface Props {
	items: IndexItem[];
	lang: Lang;
	compact?: boolean;
}

const { items, lang, compact = false } = Astro.props;
const t = getUi(lang);
---

<ol class:list={["index-list", { "index-list--compact": compact }]}>
	{
		items.map((item, index) => (
			<li>
				<a class="index-card" href={item.url}>
					<span class="index-format" data-format={item.format}>
						{t.formats[item.format]}
					</span>
					<span class="index-no">{String(index + 1).padStart(2, "0")}</span>
					<span class="index-main">
						<span class="index-title">{item.title}</span>
						<span class="index-meta">
							{item.meta && (
								<>
									{item.meta}
									<span class="sep" aria-hidden="true">·</span>
								</>
							)}
							<time datetime={item.date.toISOString()}>{dateLabel(item.date, lang)}</time>
						</span>
						{item.summary && <span class="index-summary">{item.summary}</span>}
					</span>
					<span class="index-arrow" aria-hidden="true">→</span>
				</a>
			</li>
		))
	}
</ol>
