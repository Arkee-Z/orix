---
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Page not found"
	section="Missing Leaf"
	folio="—"
	description="This leaf was torn out of the journal."
>
	<div class="lost">
		<p class="lost-figure" aria-hidden="true">404</p>
		<h1 class="lost-title">This leaf was torn out.</h1>
		<p>
			The page you asked for is not in this volume. It may have been moved,
			renamed, or never written at all — the archive is honest about that sort of
			thing.
		</p>
		<a class="btn" href="/">
			Return to the index <span class="arrow" aria-hidden="true">→</span>
		</a>
	</div>
</Layout>
