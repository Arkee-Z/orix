---
import Layout from "../layouts/Layout.astro";
import { localeHref } from "../i18n/ui";
---
<Layout lang="zh" section="迷路" folio="—" altHref="/en/" title="页面不存在">
	<div class="lost">
		<p class="lost-figure" aria-hidden="true">404</p>
		<h1 class="lost-title">这一页不在本卷里。</h1>
		<p>
			你找的页面可能已移动、更名，或只是还没写出来。回到卷首，或者从英文版重新开始。
		</p>
		<p class="lost-en">This page is not in this issue. <a href="/en/">Open the English edition →</a></p>
		<a class="btn" href={localeHref("zh", "/")}>返回卷首 <span class="arrow" aria-hidden="true">→</span></a>
	</div>
</Layout>
