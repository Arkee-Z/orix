---
import Layout from "../layouts/Layout.astro";
import { formatDate, pad } from "../data/site";
import { notes } from "../data/notes";

const count = pad(notes.length);
const tags = [...new Set(notes.map((note) => note.tag))];

const noteDate = (value: string) => formatDate(new Date(`${value}T00:00:00Z`));
---

<Layout
	title="Notes"
	section="Notes"
	folio="03"
	description="Short field notes from the desk of Gene Max Zhang — logs, reading, and small tools."
>
	<header class="page-head-block">
		<p class="imprint">Section 03 / 05</p>
		<h1 class="page-title">Field Notes</h1>
		<p class="page-dek">
			Short entries, kept in the back of the notebook. A log of small tools,
			half-finished thoughts, and things worth remembering from the desk.
		</p>
	</header>

	<div class="notes-layout">
		<ol class="notes-list">
			{
				notes.map((note) => (
					<li class="note">
						<div class="note-date">
							<time datetime={note.date}>{noteDate(note.date)}</time>
							<span class="note-tag">[{note.tag}]</span>
						</div>
						<div class="note-body">
							<p>{note.text}</p>
						</div>
					</li>
				))
			}
		</ol>

		<aside class="notes-margin" aria-label="About these notes">
			<div>
				<p class="margin-label">Marginalia</p>
				<p class="margin-text">
					Published without revision, in the order they were written.
				</p>
			</div>

			<div class="margin-count">
				<span class="margin-number">{count}</span>
				<span class="margin-count-label">Fragments</span>
			</div>

			<div>
				<p class="margin-label">Filed under</p>
				<ul class="tag-cloud">
					{tags.map((tag) => <li>{tag}</li>)}
				</ul>
			</div>

		</aside>
	</div>
</Layout>
