---
import { render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import SyndicationLinks from "../../../components/SyndicationLinks.astro";
import { site } from "../../../data/site";
import {
	dateLabel,
	getUi,
	languages,
	localeHref,
	otherLang,
	mediumLabel,
	stars,
	type Lang,
} from "../../../i18n/ui";
import { getMusic, musicHref, type Music } from "../../../lib/posts";

export async function getStaticPaths() {
	const paths = [];
	for (const lang of languages) {
		const entries = await getMusic(lang);
		for (const entry of entries) {
			paths.push({ params: { lang, slug: entry.id }, props: { entry } });
		}
	}
	return paths;
}

const lang = Astro.params.lang as Lang;
const entry = Astro.props.entry as Music;
const t = getUi(lang);
const { Content } = await render(entry);
const all = await getMusic(lang);
const position = all.findIndex((item) => item.id === entry.id);
const newer = position > 0 ? all[position - 1] : undefined;
const older = position < all.length - 1 ? all[position + 1] : undefined;
const medium = mediumLabel(entry.data.medium, lang);
---

<Layout
	title={entry.data.title}
	section={t.music.section}
	folio="03"
	lang={lang}
	description={entry.data.summary || t.music.de}
	altHref={localeHref(lang === "zh" ? "en" : "zh", "/music")}
	mainClass="entry-page entry-page--music"
>
	<article class:list={["entry", "entry--review", "entry--music", `entry--${lang}`]} lang={entry.data.lang === "zh" ? "zh-CN" : "en"}>
		<header>
			<p class="entry-kicker">
				<a class="entry-genre" href={localeHref(lang, "/music")}>{t.music.section}</a>
				<span class="sep" aria-hidden="true">/</span>
				<span>{medium}</span>
				{entry.data.tags.map((tag) => (
					<>
						<span class="sep" aria-hidden="true">·</span>
						<span class="tag">{tag}</span>
					</>
				))}
			</p>
			<h1 class="article-title">{entry.data.title}</h1>
			{entry.data.summary && <p class="article-dek">{entry.data.summary}</p>}
			<p class="entry-byline">
				<span>{entry.data.artist}</span>
				<span class="sep" aria-hidden="true">·</span>
				<span>{entry.data.release ?? medium}</span>
				{entry.data.year && (
					<>
						<span class="sep" aria-hidden="true">·</span>
						<span>{entry.data.year}</span>
					</>
				)}
			</p>
			{entry.data.rating !== undefined && (
				<p class="review-rating review-rating--lead">
					<span>{t.music.rating}</span>
					<span class="review-stars">{stars(entry.data.rating)}</span>
					<span>{entry.data.rating}/5</span>
				</p>
			)}
		</header>

		{entry.data.cover && (
			<figure class="review-cover">
				<img src={entry.data.cover} alt={entry.data.release ?? entry.data.title} loading="lazy" />
			</figure>
		)}

		<div class="article-body review-layout">
			<aside class="marginalia" aria-label={lang === "zh" ? "唱片信息" : "Record details"}>
				<div class="meta-block">
					<span class="meta-label">{t.music.artists}</span>
					<span class="meta-value">{entry.data.artist}</span>
				</div>
				{entry.data.release && (
					<div class="meta-block">
						<span class="meta-label">{lang === "zh" ? "唱片" : "Release"}</span>
						<span class="meta-value">{entry.data.release}</span>
					</div>
				)}
				<div class="meta-block">
					<span class="meta-label">{lang === "zh" ? "媒介" : "Format"}</span>
					<span class="meta-value">{medium}</span>
				</div>
				{entry.data.year && (
					<div class="meta-block">
						<span class="meta-label">{lang === "zh" ? "年份" : "Year"}</span>
						<span class="meta-value">{entry.data.year}</span>
					</div>
				)}
				{entry.data.label && (
					<div class="meta-block">
						<span class="meta-label">{lang === "zh" ? "厂牌" : "Label"}</span>
						<span class="meta-value">{entry.data.label}</span>
					</div>
				)}
				<div class="meta-block">
					<span class="meta-label">{t.entry.filed}</span>
					<span class="meta-value">
						<time datetime={entry.data.date.toISOString()}>{dateLabel(entry.data.date, lang)}</time>
					</span>
				</div>
			</aside>
			<div class="prose" lang={entry.data.lang === "zh" ? "zh-CN" : "en"}>
				<Content />
			</div>
		</div>

		{entry.data.links.length > 0 && (
			<section class="review-links" aria-label={t.entry.externalLinks}>
				<p class="sync-label">{t.entry.externalLinks}</p>
				<ul class="sync-links">
					{entry.data.links.map((link) => (
						<li><a href={link.url} target="_blank">{link.label} ↗</a></li>
					))}
				</ul>
			</section>
		)}

		<SyndicationLinks links={entry.data.syndication} lang={lang} />

		<footer class="article-foot">
			<nav class="entry-nav" aria-label={t.music.all}>
				{older ? (
					<a href={musicHref(older, lang)}>
						<span class="dir">← {t.entry.older}</span>
						<span class="title">{older.data.title}</span>
					</a>
				) : (
					<a href={localeHref(lang, "/music")}>
						<span class="dir">← {t.entry.backToMusic}</span>
						<span class="title">{t.music.all}</span>
					</a>
				)}
				{newer ? (
					<a class="next" href={musicHref(newer, lang)}>
						<span class="dir">{t.entry.newer} →</span>
						<span class="title">{newer.data.title}</span>
					</a>
				) : (
					<a class="next" href={localeHref(lang, "/music")}>
						<span class="dir">{t.entry.backToMusic} →</span>
						<span class="title">{t.music.all}</span>
					</a>
				)}
			</nav>
		</footer>
	</article>
</Layout>
