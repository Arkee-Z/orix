---
import Layout from "../../../layouts/Layout.astro";
import IndexList from "../../../components/IndexList.astro";
import { getUi, languages, localeHref, type Lang } from "../../../i18n/ui";
import { getIndexItems } from "../../../lib/posts";

export function getStaticPaths() {
	return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = getUi(lang);
const items = await getIndexItems(lang);
---

<Layout
	title={t.nav.catalog}
	section={t.nav.catalog}
	folio="02"
	lang={lang}
	description={
		lang === "zh"
			? "文字、声音与图像按时间排在一起，不按形式分栏。"
			: "Text, sound and image in one sequence, without sections by form."
	}
	altHref={localeHref(lang === "zh" ? "en" : "zh", "/index")}
>
	<header class="page-head-block">
		<p class="imprint">02 — {t.nav.catalog}</p>
		<h1 class="page-title">{t.nav.catalog}</h1>
		<p class="page-dek">
			{lang === "zh"
				? "文字、声音与图像按时间排在一起，不按形式分栏。"
				: "Text, sound and image in one sequence, without sections by form."}
		</p>
	</header>

	<div class="list-head">
		<span>{lang === "zh" ? "全部作品" : "All works"}</span>
		<span>{String(items.length).padStart(2, "0")}</span>
	</div>

	<IndexList items={items} lang={lang} />

	<p class="end-mark" aria-hidden="true">· · ·</p>
</Layout>
