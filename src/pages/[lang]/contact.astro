---
import Layout from "../../layouts/Layout.astro";
import { site } from "../../data/site";
import { getUi, languages, localeHref, type Lang } from "../../i18n/ui";

export function getStaticPaths() {
	return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = getUi(lang);

const copy =
	lang === "zh"
		? {
				title: "联系",
				dek: "系统、出版工具、开发者界面，以及偶尔出现的好 bug 报告。",
				letterTitle: "一封信，不是一张表单。",
				letter: [
					"没有表单，没有验证码，没有假装是人的聊天窗口。只有一个地址和一个承诺：每封信都会读，按到达顺序回复。",
					"如果是 bug，请附上版本和你能忍受的最短复现。如果是约稿或合作，请直接说明你正在做什么、需要什么，以及为什么是现在。",
				],
				cta: "写信",
				availability: "开放有趣的工作：系统、出版工具、开发者界面。不开放增长营销合作，也不回复会自动祝我生日快乐的软件。",
				label: "通信",
		  }
		: {
				title: "Contact",
				dek: "Systems, publishing tools, developer interfaces, and the occasional good bug report.",
				letterTitle: "A letter, not a form.",
				letter: [
					"No form, no captcha, no chat bubble pretending to be a person. Just an address and a promise: I read everything, and answer in the order the post arrives.",
					"If it is a bug, include the version and the shortest reproduction you can bear to write. If it is a commission or a collaboration, say what you are making, what you need, and why now.",
				],
				cta: "Write a letter",
				availability:
					"Open to interesting work — systems, publishing tools, developer interfaces. Not open to growth-marketing partnerships, nor to software that emails me on its own birthday.",
				label: "Correspondence",
		  };
---

<Layout
	title={copy.title}
	section={t.nav.contact}
	folio="06"
	lang={lang}
	description={copy.dek}
	altHref={localeHref(lang === "zh" ? "en" : "zh", "/contact")}
>
	<div class="letter-page">
		<header class="page-head-block">
			<p class="imprint">06 — {copy.label}</p>
			<h1 class="page-title">{copy.title}</h1>
			<p class="page-dek">{copy.dek}</p>
		</header>

		<ul class="contact-list">
			<li class="contact-row">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z" />
					<circle cx="12" cy="10" r="2.4" />
				</svg>
				<span>{t.location}</span>
			</li>
			<li class="contact-row">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<rect x="3" y="5" width="18" height="14" rx="1.5" />
					<path d="m3.5 6.5 8.5 6 8.5-6" />
				</svg>
				<a href={`mailto:${site.email}`}>{site.email}</a>
			</li>
			<li class="contact-row">
				<svg viewBox="0 0 24 24" class="icon-fill" aria-hidden="true">
					<path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55v-2.1c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.8 1.18 1.83 1.18 3.08 0 4.41-2.7 5.38-5.27 5.67.42.36.79 1.08.79 2.18v3.23c0 .3.21.66.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z" />
				</svg>
				<a href={site.github} rel="me">{site.githubLabel}</a>
			</li>
			<li class="contact-row">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="12" r="9" />
					<path d="M12 7v5l3.5 2" />
				</svg>
				<span>{site.timezone}</span>
			</li>
		</ul>

		<div class="contact-note">
			<span class="section-mark" aria-hidden="true">§</span>
			<h2>{copy.letterTitle}</h2>
			{copy.letter.map((paragraph) => <p>{paragraph}</p>)}
			<div class="contact-actions">
				<a class="btn btn--accent" href={`mailto:${site.email}`}>
					{copy.cta} <span class="arrow" aria-hidden="true">→</span>
				</a>
			</div>
		</div>

		<footer class="letter-foot">
			<div class="letter-availability">
				<span class="meta-label">{lang === "zh" ? "状态" : "Availability"}</span>
				<p>{copy.availability}</p>
			</div>
			<p class="fingerprint">
				{t.imprint} · {t.volume}<br />
				{t.since} · {t.location}
			</p>
		</footer>
	</div>
</Layout>
