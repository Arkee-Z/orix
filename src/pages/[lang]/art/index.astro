---
import Layout from "../../../layouts/Layout.astro";
import ArtWall from "../../../components/ArtWall.astro";
import ArtLightbox from "../../../components/ArtLightbox.astro";
import { getUi, languages, localeHref, type Lang } from "../../../i18n/ui";
import { getArtPieces } from "../../../lib/posts";

export function getStaticPaths() {
	return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = getUi(lang);
const pieces = await getArtPieces(lang);
---

<Layout
	title={t.art.title}
	section={t.art.section}
	folio="04"
	lang={lang}
	description={t.art.de}
	altHref={localeHref(lang === "zh" ? "en" : "zh", "/art")}
>
	<header class="page-head-block">
		<p class="imprint">04 — {t.art.section}</p>
		<h1 class="page-title">{t.art.title}</h1>
		<p class="page-dek">{t.art.de}</p>
	</header>

	<div class="list-head">
		<span>{t.art.gallery}</span>
		<span>{pieces.length} {t.art.works}</span>
	</div>

	{pieces.length > 0 ? <ArtWall pieces={pieces} lang={lang} /> : <p class="empty-note">{t.art.empty}</p>}

	<ArtLightbox lang={lang} />
</Layout>
