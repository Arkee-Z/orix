---
import Layout from "../../layouts/Layout.astro";
import IndexList from "../../components/IndexList.astro";
import { site } from "../../data/site";
import {
	languages,
	getUi,
	localeHref,
	dateLabel,
	type Lang,
} from "../../i18n/ui";
import { getIndexItems } from "../../lib/posts";

export function getStaticPaths() {
	return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = getUi(lang);
const items = await getIndexItems(lang);
const feature = items[0];
const recent = items.slice(1, 5);
---

<Layout
	section={t.nav.index}
	folio="01"
	lang={lang}
	altHref={localeHref(lang === "zh" ? "en" : "zh", "/")}
	mainClass="cover-page"
>
	<div class="cover">
		<div class="cover-kicker">
			<span>{t.home.notebook}</span>
			<span class="dot" aria-hidden="true">·</span>
			<span>{t.volume}</span>
			<span class="dot" aria-hidden="true">·</span>
			<span>{site.year}</span>
		</div>

		<div class="cover-grid">
			<header class="cover-lead">
				<h1 class="cover-word">Orix</h1>
				<p class="cover-cn">
					{lang === "zh" ? "文艺志" : "Journal"}
					<span>{lang === "zh" ? "文字 · 声音 · 图像" : "Text · Sound · Image"}</span>
				</p>
				<p class="cover-statement">{t.home.role}</p>
				<p class="cover-intro">{t.home.intro}</p>
				<p class="cover-editor">
					{t.home.name} <span aria-hidden="true">·</span>
					{lang === "zh" ? "主编" : "Editor"}
				</p>
			</header>

			<aside class="cover-feature" aria-label={t.home.selected}>
				<div class="cover-label">
					<span>{t.home.selected}</span>
					<span>{lang === "zh" ? "本期" : "Featured"}</span>
				</div>

				{
					feature ? (
						<a class="feature" href={feature.url}>
							<span class="feature-kind">{t.formats[feature.format]}</span>
							<h2 class="feature-title">{feature.title}</h2>
							{feature.summary && <p class="feature-dek">{feature.summary}</p>}
							<span class="feature-foot">
								<time datetime={feature.date.toISOString()}>
									{dateLabel(feature.date, lang)}
								</time>
								<span class="feature-cta">
									{lang === "zh" ? "打开" : "Open"} <span aria-hidden="true">→</span>
								</span>
							</span>
						</a>
					) : (
						<p class="empty-note">{t.home.empty}</p>
					)
				}
			</aside>
		</div>

		<section class="home-contents" aria-label={lang === "zh" ? "本期目录" : "Contents"}>
			<div class="list-head">
				<span>{lang === "zh" ? "本期目录" : "Contents"}</span>
				<span>{String(items.length).padStart(2, "0")}</span>
			</div>

			{recent.length > 0 ? (
				<IndexList items={recent} lang={lang} compact />
			) : (
				<p class="empty-note">{t.home.empty}</p>
			)}

			<a class="text-link home-contents-link" href={localeHref(lang, "/index")}>
				{lang === "zh" ? "全部目录" : "Full index"}
				<span aria-hidden="true">→</span>
			</a>
		</section>

		<p class="cover-colophon">
			<span>{t.imprint} · {t.volume}</span>
			<span>{t.location}</span>
			<span>{t.since}</span>
		</p>
	</div>
</Layout>
