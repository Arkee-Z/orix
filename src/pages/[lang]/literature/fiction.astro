---
import Layout from "../../../layouts/Layout.astro";
import GenreNav from "../../../components/GenreNav.astro";
import WritingList from "../../../components/WritingList.astro";
import { getUi, languages, localeHref, dateLabel, type Lang } from "../../../i18n/ui";
import { chapterLabel, getPosts, groupSeries, postHref, seriesHref } from "../../../lib/posts";

export function getStaticPaths() {
	return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = getUi(lang);
const entries = await getPosts(lang, "fiction");
const groups = groupSeries(entries).filter((group) => group.kind === "fiction");
const standalone = entries.filter((entry) => !entry.data.series);
---

<Layout
	title={lang === "zh" ? "小说" : "Fiction"}
	section={t.literature.section}
	folio="02"
	lang={lang}
	description={lang === "zh" ? "小说与系列" : "Fiction and series"}
	altHref={localeHref(lang === "zh" ? "en" : "zh", "/literature/fiction")}
>
	<header class="page-head-block">
		<p class="imprint">02 — {lang === "zh" ? "小说" : "Fiction"}</p>
		<h1 class="page-title">{lang === "zh" ? "小说" : "Fiction"}</h1>
		<p class="page-dek">
			{lang === "zh"
				? "长篇与短篇；章节、系列和未完成的世界。"
				: "Novels, stories, chapters and unfinished worlds."}
		</p>
	</header>

	<nav class="category-back" aria-label={t.literature.back}>
		<a href={localeHref(lang, "/literature")}>← {t.literature.back}</a>
	</nav>

	<GenreNav lang={lang} active="fiction" />

	{
		groups.length > 0 && (
			<section class="series-section">
				<h2 class="section-title">
					<span class="section-mark" aria-hidden="true">§</span>
					<span>{t.literature.books}</span>
					<span class="section-note">{groups.length}</span>
				</h2>
				<div class="series-list">
					{groups.map((group, index) => {
						const first = group.entries[0];
						const latest = group.entries[group.entries.length - 1];
						return (
							<a class="series-card" href={seriesHref(group.series, lang)}>
								<span class="series-card-no">{String(index + 1).padStart(2, "0")}</span>
								<span class="series-card-main">
									<span class="series-card-title">{group.title}</span>
									<span class="series-card-meta">
										{group.entries.length} {lang === "zh" ? "章" : "chapters"}
										<span class="sep" aria-hidden="true">·</span>
										{lang === "zh" ? "最近" : "latest"}: {latest.data.title}
									</span>
									{first.data.summary && (
										<span class="series-card-summary">{first.data.summary}</span>
									)}
								</span>
								<span class="series-card-arrow" aria-hidden="true">→</span>
							</a>
						);
					})}
				</div>
			</section>
		)
	}

	{
		standalone.length > 0 && (
			<section class="standalone-section">
				<h2 class="section-title">
					<span class="section-mark" aria-hidden="true">§</span>
					<span>{lang === "zh" ? "短篇" : "Short stories"}</span>
					<span class="section-note">{standalone.length}</span>
				</h2>
				<WritingList entries={standalone} lang={lang} empty={t.literature.empty} />
			</section>
		)
	}

	{
		entries.length === 0 && <p class="empty-note">{t.literature.empty}</p>
	}

	<p class="end-mark">— {lang === "zh" ? "待续" : "to be continued"} —</p>
</Layout>
