---
import { render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import SyndicationLinks from "../../../components/SyndicationLinks.astro";
import { site } from "../../../data/site";
import {
	dateLabel,
	getUi,
	languages,
	localeHref,
	otherLang,
	type Lang,
} from "../../../i18n/ui";
import {
	chapterLabel,
	genreMeta,
	getPosts,
	postHref,
	seriesHref,
	seriesTitle,
	sortSeries,
	type Post,
} from "../../../lib/posts";

export async function getStaticPaths() {
	const paths = [];
	for (const lang of languages) {
		const posts = await getPosts(lang);
		for (const post of posts) {
			paths.push({ params: { lang, slug: post.id }, props: { post } });
		}
	}
	return paths;
}

const lang = Astro.params.lang as Lang;
const post = Astro.props.post as Post;
const t = getUi(lang);
const genre = genreMeta(post.data.kind);
const { Content } = await render(post);
const kind = post.data.kind;
const all = await getPosts(lang);
const sameKind = all.filter((entry) => entry.data.kind === kind);
const series = post.data.series
	? sortSeries(sameKind.filter((entry) => entry.data.series === post.data.series))
	: [];
const ordered = series.length ? series : sameKind;
const position = ordered.findIndex((entry) => entry.id === post.id);
const previous = position > 0 ? ordered[position - 1] : undefined;
const next = position >= 0 && position < ordered.length - 1 ? ordered[position + 1] : undefined;
const seriesName = series.length ? seriesTitle(series) : post.data.seriesTitle;
const chapter = chapterLabel(post, lang);
const poemBody = (post.body ?? "").trim();

// The English and Chinese editions are separate; if a translation exists via
// translationKey, link it. Otherwise the language switch lands on the category.
const other = otherLang(lang);
const otherPosts = await getPosts(other);
const translated = post.data.translationKey
	? otherPosts.find((entry) => entry.data.translationKey === post.data.translationKey)
	: undefined;
const altHref = translated
	? postHref(translated, other)
	: localeHref(other, "/index");

const categoryHref = localeHref(lang, "/index");
const isPoem = kind === "poem";
const isFiction = kind === "fiction";
const visibleTags = post.data.tags.filter(
	(tag) => tag !== genre.zh && tag !== genre.en,
);
const previousLabel = isPoem
	? lang === "zh" ? "上一首" : "Previous poem"
	: isFiction
		? lang === "zh" ? "上一章" : "Previous chapter"
		: t.entry.previous;
const nextLabel = isPoem
	? lang === "zh" ? "下一首" : "Next poem"
	: isFiction
		? lang === "zh" ? "下一章" : "Next chapter"
		: t.entry.next;
---

<Layout
	title={post.data.title}
	section={t.literature.section}
	folio="02"
	lang={lang}
	description={post.data.summary || t.literature.de}
	altHref={altHref}
	mainClass={`entry-page entry-page--${kind}`}
>
	<article class:list={["entry", `entry--${kind}`, `entry--${lang}`]} lang={post.data.lang === "zh" ? "zh-CN" : "en"}>
		<header>
			<p class="entry-kicker">
				<span class="entry-format">{t.formats.text}</span>
				{series.length > 0 && (
					<>
						<span class="sep" aria-hidden="true">/</span>
						<a href={seriesHref(post.data.series!, lang)}>{seriesName}</a>
					</>
				)}
				{chapter && (
					<>
						<span class="sep" aria-hidden="true">/</span>
						<span>{chapter}</span>
					</>
				)}
				{visibleTags.map((tag) => (
					<>
						<span class="sep" aria-hidden="true">·</span>
						<span class="tag">{tag}</span>
					</>
				))}
			</p>

			<h1 class={isPoem ? "article-title poem-title" : "article-title"}>
				{post.data.title}
			</h1>

			{post.data.summary && (
				<p class={isPoem ? "poem-epigraph" : "article-dek"}>{post.data.summary}</p>
			)}

			<p class="entry-byline">
				<span>{lang === "zh" ? "文" : "By"} {site.name}</span>
				{isPoem && (
					<>
						<span class="sep" aria-hidden="true">·</span>
						<time datetime={post.data.date.toISOString()}>
							{dateLabel(post.data.date, lang)}
						</time>
					</>
				)}
			</p>
		</header>

		{isPoem ? (
			<pre class="poem-text" lang={post.data.lang === "zh" ? "zh-CN" : "en"}>{poemBody}</pre>
		) : (
			<div class:list={["article-body", { "fiction-layout": isFiction }]}>
				<aside class="marginalia" aria-label={lang === "zh" ? "作品信息" : "Work details"}>
					{series.length > 0 && (
						<div class="meta-block">
							<span class="meta-label">{t.entry.series}</span>
							<span class="meta-value">
								<a href={seriesHref(post.data.series!, lang)}>{seriesName}</a>
							</span>
						</div>
					)}
					{chapter && isFiction && (
						<div class="meta-block">
							<span class="meta-label">{t.entry.chapter}</span>
							<span class="meta-value">{chapter}</span>
						</div>
					)}
					<div class="meta-block">
						<span class="meta-label">{t.entry.filed}</span>
						<span class="meta-value">
							<time datetime={post.data.date.toISOString()}>
								{dateLabel(post.data.date, lang)}
							</time>
						</span>
					</div>
					{post.data.minutes && (
						<div class="meta-block">
							<span class="meta-label">{t.entry.reading}</span>
							<span class="meta-value">{post.data.minutes} {t.entry.minutes}</span>
						</div>
					)}
					{post.data.tags.length > 0 && (
						<div class="meta-block">
							<span class="meta-label">{lang === "zh" ? "标签" : "Tags"}</span>
							<span class="meta-value">{post.data.tags.join(" / ")}</span>
						</div>
					)}
				</aside>

				<div class:list={["prose", { "fiction-body": isFiction }]} lang={post.data.lang === "zh" ? "zh-CN" : "en"}>
					<Content />
				</div>
			</div>
		)}

		<SyndicationLinks links={post.data.syndication} lang={lang} />

		<footer class="article-foot">
			{series.length > 0 && post.data.series && (
				<p class="series-return">
					<a class="text-link" href={seriesHref(post.data.series, lang)}>
						← {isPoem ? t.entry.collection : t.entry.series}: {seriesName}
					</a>
				</p>
			)}

			<nav class="entry-nav" aria-label={lang === "zh" ? "作品导航" : "Work navigation"}>
				{previous ? (
					<a href={postHref(previous, lang)}>
						<span class="dir">← {previousLabel}</span>
						<span class="title">{previous.data.title}</span>
					</a>
				) : (
					<a href={categoryHref}>
						<span class="dir">← {t.nav.catalog}</span>
						<span class="title">{t.nav.catalog}</span>
					</a>
				)}
				{next ? (
					<a class="next" href={postHref(next, lang)}>
						<span class="dir">{nextLabel} →</span>
						<span class="title">{next.data.title}</span>
					</a>
				) : (
					<a class="next" href={categoryHref}>
						<span class="dir">{t.nav.catalog} →</span>
						<span class="title">{t.nav.catalog}</span>
					</a>
				)}
			</nav>
		</footer>
	</article>
</Layout>
