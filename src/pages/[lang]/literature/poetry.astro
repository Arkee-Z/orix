---
import Layout from "../../../layouts/Layout.astro";
import GenreNav from "../../../components/GenreNav.astro";
import WritingList from "../../../components/WritingList.astro";
import { getUi, languages, localeHref, type Lang } from "../../../i18n/ui";
import { getPosts, groupSeries, seriesHref } from "../../../lib/posts";

export function getStaticPaths() {
	return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = getUi(lang);
const entries = await getPosts(lang, "poem");
const groups = groupSeries(entries).filter((group) => group.kind === "poem");
const standalone = entries.filter((entry) => !entry.data.series);
---

<Layout
	title="Poetry"
	section={t.literature.section}
	folio="02"
	lang={lang}
	description={lang === "zh" ? "分行写下的东西" : "Words set in lines"}
	altHref={localeHref(lang === "zh" ? "en" : "zh", "/literature/poetry")}
>
	<header class="page-head-block">
		<p class="imprint">02 — {lang === "zh" ? "诗" : "Poetry"}</p>
		<h1 class="page-title">{lang === "zh" ? "诗" : "Poetry"}</h1>
		<p class="page-dek">
			{lang === "zh"
				? "分行写下的东西；保留换行与空白。"
				: "Words set in lines, with their breaks and silences kept."}
		</p>
	</header>

	<nav class="category-back" aria-label={t.literature.back}>
		<a href={localeHref(lang, "/literature")}>← {t.literature.back}</a>
	</nav>

	<GenreNav lang={lang} active="poem" />

	{
		groups.map((group) => (
			<section class="poetry-collection">
				<div class="poetry-collection-head">
					<h2 class="section-title">
						<span class="section-mark" aria-hidden="true">§</span>
						<span>{group.title}</span>
						<span class="section-note">{group.entries.length} {lang === "zh" ? "首" : "poems"}</span>
					</h2>
					<a class="text-link" href={seriesHref(group.series, lang)}>
						{lang === "zh" ? "打开诗集" : "Open collection"} →
					</a>
				</div>
				<WritingList entries={group.entries} lang={lang} empty={t.literature.empty} />
			</section>
		))
	}

	{
		standalone.length > 0 && (
			<section class="poetry-standalone">
				<h2 class="section-title">
					<span class="section-mark" aria-hidden="true">§</span>
					<span>{lang === "zh" ? "零散的诗" : "Uncollected"}</span>
				</h2>
				<WritingList entries={standalone} lang={lang} empty={t.literature.empty} />
			</section>
		)
	}

	{
		entries.length === 0 && <p class="empty-note">{t.literature.empty}</p>
	}

	<p class="end-mark">— {lang === "zh" ? "完" : "fin"} —</p>
</Layout>
