---
import Layout from "../layouts/Layout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { site } from "../data/site";

const skills = [
	{ key: "Languages", value: "TypeScript, Go, C, Python, Rust" },
	{ key: "Frontend", value: "Fresh, PWA, Wails, WASM" },
	{ key: "Backend", value: "Deno, SQLite, Gin, FastAPI" },
	{ key: "Infra", value: "Docker, Linux, GitHub Actions" },
];

const projects = [
	{
		title: "Orix Journal",
		year: "2024 — now",
		text: "This very site. A terminal-native journal built with Astro, Markdown, and hand-written CSS, published from the command line and set like a printed magazine.",
	},
	{
		title: "Vetem",
		year: "2023 — now",
		text: "A small publishing pipeline that turns a folder of Markdown into a site with no runtime dependencies. The quieter sibling of this journal.",
	},
	{
		title: "Open source",
		year: "Ongoing",
		text: "Active contributor on GitHub — mostly small utilities, editor tooling, and fixes for the libraries I lean on every day.",
	},
];
---

<Layout
	title="About"
	section="About"
	folio="04"
	description="About Gene Max Zhang — full-stack engineer, open-source contributor, terminal enthusiast."
>
	<div class="spread">
		<section>
			<header class="page-head-block">
				<p class="imprint">Section 04 / 05</p>
				<h1 class="page-title">About the<br /> Author</h1>
				<p class="page-dek">
					Engineer by trade, reader by temperament, terminal resident by choice.
				</p>
			</header>

			<div class="profile-plate" aria-hidden="true">
				<span class="profile-initials">GMZ</span>
				<span class="profile-caption">Gene Max Zhang · Chengdu · Est. MMXIX</span>
			</div>

			<div class="about-copy">
				<p>
					I build the web through terminals. My work spans full-stack
					engineering with a focus on Rust, TypeScript, and Go — from database
					schemas and HTTP handlers to the last pixel of a page. This journal
					itself is a terminal-driven experiment: every page you see here was
					published, edited, and styled entirely through the command pane.
				</p>
				<p>
					I believe the terminal is the most honest interface between a developer
					and their machine. Everything else is decoration. That belief shows up
					in the tools I choose, the interfaces I design, and the amount of
					patience I have for software that performs confidence instead of
					reporting state.
				</p>
				<p>
					I live in Chengdu, where the rain is frequent and the tea is better
					than the coffee. When I am not shipping, I am reading source code,
					taking notes in the margins, and slowly learning to write shorter
					sentences.
				</p>
			</div>

			<blockquote class="motto">
				“Code is poetry written in logic.”
				<cite>— Working motto</cite>
			</blockquote>
		</section>

		<div class="spread-rule" aria-hidden="true"></div>

		<section>
			<SectionTitle title="Skills" note="Current shelf" />

			<div class="skills">
				{
					skills.map((skill) => (
						<div class="skill-row">
							<span class="skill-key">{skill.key}</span>
							<span class="skill-val">{skill.value}</span>
						</div>
					))
				}
			</div>

			<div class="block-gap" aria-hidden="true"></div>

			<SectionTitle title="Projects" note="Selected work" />

			<div class="projects">
				{
					projects.map((project) => (
						<article class="project">
							<div class="project-head">
								<h3 class="project-title">{project.title}</h3>
								<span class="project-year">{project.year}</span>
							</div>
							<p>{project.text}</p>
						</article>
					))
				}
			</div>

			<div class="colophon">
				<strong>Colophon</strong>
				Labels set in IBM Plex Mono and Space Mono; display and text in the
				native editorial serif. Built with Astro and held together with
				hand-written CSS. The paper is a generated newsprint tile, the rules
				are borders, and the departments across the top are the navigation.
				Written in {site.location}.
			</div>
		</section>
	</div>
</Layout>
