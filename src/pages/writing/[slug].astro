---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { formatDate, roman, pad } from "../../data/site";
import { getPosts, postHref } from "../../lib/posts";

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: { post, index },
	}));
}

const { post, index } = Astro.props;
const { Content } = await render(post);

const posts = await getPosts();
const position = posts.findIndex((entry) => entry.id === post.id);
const newer = position > 0 ? posts[position - 1] : undefined;
const older = position < posts.length - 1 ? posts[position + 1] : undefined;

const folio = pad(6 + index);
---

<Layout
	title={post.data.title}
	section="Writing"
	folio={folio}
	description={post.data.summary}
>
	<article>
		<header>
			<p class="entry-kicker">
				<span>Entry {roman(index + 1)}</span>
				<span class="sep" aria-hidden="true">/</span>
				<span class="tag">{post.data.tags.join(" · ")}</span>
			</p>
			<h1 class="article-title">{post.data.title}</h1>
			<p class="article-dek">{post.data.summary}</p>
		</header>

		<div class="article-body">
			<aside class="marginalia" aria-label="Entry details">
				<div class="meta-block">
					<span class="meta-label">Filed</span>
					<span class="meta-value">
						<time datetime={post.data.date.toISOString()}>
							{formatDate(post.data.date)}
						</time>
					</span>
				</div>
				<div class="meta-block">
					<span class="meta-label">Reading</span>
					<span class="meta-value">{post.data.minutes} minutes</span>
				</div>
			</aside>

			<div class="prose">
				<Content />
			</div>
		</div>

		<footer class="article-foot">
			<nav class="entry-nav" aria-label="Entry navigation">
				{
					older ? (
						<a href={postHref(older)}>
							<span class="dir">← Older entry</span>
							<span class="title">{older.data.title}</span>
						</a>
					) : (
						<a href="/writing">
							<span class="dir">← The archive</span>
							<span class="title">All entries</span>
						</a>
					)
				}
				{
					newer ? (
						<a class="next" href={postHref(newer)}>
							<span class="dir">Newer entry →</span>
							<span class="title">{newer.data.title}</span>
						</a>
					) : (
						<a class="next" href="/writing">
							<span class="dir">The archive →</span>
							<span class="title">All entries</span>
						</a>
					)
				}
			</nav>
		</footer>
	</article>
</Layout>
